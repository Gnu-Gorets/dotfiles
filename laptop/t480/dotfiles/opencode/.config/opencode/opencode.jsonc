{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "{env:HOME}/.agents/skills/pohuy/SKILL.md",
    "{env:HOME}/.config/opencode/AGENTS.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "* {env:HOME}/Documents/Projects*": "allow",
      "{env:HOME}/Documents/Projects*": "allow"
    },
    "edit": {
      "*": "ask",
      "{env:HOME}/Documents/Projects/**": "allow"
    },
    "external_directory": {
      "{env:HOME}/Documents/Projects/**": "allow"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail",
    "./plugins/pohuy-state.ts"
  ]
}
